# GrokMax environment configuration.
# Copy to .env and fill in only what you have. GrokMax works without any of these.

# Optional: location of the SQLite database (default: <grokmax>/data/grokmax.db)
# GROKMAX_DB=./data/grokmax.db

# Optional: home for artifact file storage (default: <grokmax>/data/artifacts)
# GROKMAX_ARTIFACTS_DIR=./data/artifacts

# Optional: scratch/session cookie for scoping (default derived from project path)
# GROKMAX_SCOPE=default

# Optional: API keys. GrokMax degrades gracefully when these are absent.
# GROKMAX_OPENCODE_BIN=opencode
# GROKMAX_CHATGPT_API_KEY=
# GROKMAX_API_ENDPOINT=
# GROKMAX_GROKBOT_BRIDGE=