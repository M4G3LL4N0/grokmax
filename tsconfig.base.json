{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@grokmax/core": ["./packages/core/src/index.ts"],
      "@grokmax/cache": ["./packages/cache/src/index.ts"],
      "@grokmax/compiler": ["./packages/compiler/src/index.ts"],
      "@grokmax/context": ["./packages/context/src/index.ts"],
      "@grokmax/router": ["./packages/router/src/index.ts"],
      "@grokmax/ledger": ["./packages/ledger/src/index.ts"],
      "@grokmax/artifacts": ["./packages/artifacts/src/index.ts"],
      "@grokmax/providers": ["./packages/providers/src/index.ts"],
      "@grokmax/adapters": ["./packages/adapters/src/index.ts"],
      "@grokmax/telemetry": ["./packages/telemetry/src/index.ts"],
      "@grokmax/doctor": ["./packages/doctor/src/index.ts"]
    }
  }
}